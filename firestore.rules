rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    match /debug_errors/{id} { allow read, write: if true; }
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /tasks/{taskId} {
      allow read, write: if request.auth != null && resource == null || (resource.data.ownerId == request.auth.uid || request.resource.data.ownerId == request.auth.uid);
    }
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null && resource == null || (resource.data.ownerId == request.auth.uid || request.resource.data.ownerId == request.auth.uid);
    }
    match /goals/{goalId} {
      allow read, write: if request.auth != null && resource == null || (resource.data.ownerId == request.auth.uid || request.resource.data.ownerId == request.auth.uid);
    }
    match /notes/{noteId} {
      allow read, write: if request.auth != null && resource == null || (resource.data.ownerId == request.auth.uid || request.resource.data.ownerId == request.auth.uid);
    }
  }
}
